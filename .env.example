# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://vpn:vpn_dev_password@localhost:5432/vpn_saas?schema=public

# Auth.js
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true

# Stripe (test mode keys)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Stripe Price IDs (created in Stripe dashboard, then re-run db:seed)
STRIPE_PRICE_BASIC=price_xxx
STRIPE_PRICE_BASIC_YEARLY=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_PRO_YEARLY=price_xxx
STRIPE_PRICE_ENTERPRISE=price_xxx
STRIPE_PRICE_ENTERPRISE_YEARLY=price_xxx

# Admin bootstrap (used by seed script)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMeNow123!

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# At-rest encryption for VPN private keys, PSKs, and stored SSH keys.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# Bearer token required by /api/cron/* sweep endpoints.
CRON_SECRET=replace-with-a-long-random-string

# Per-server SSH dial timeout.
SSH_TIMEOUT_MS=15000

# Logging
LOG_LEVEL=info

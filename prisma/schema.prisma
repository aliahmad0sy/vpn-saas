generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
}

enum PlanTier {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum BillingInterval {
  MONTH
  YEAR
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  UNCOLLECTIBLE
  VOID
}

enum PeerSyncAction {
  ADD
  REMOVE
}

enum PeerSyncStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum ServerStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

enum VpnConfigStatus {
  ACTIVE
  REVOKED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  passwordHash  String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  stripeCustomerId String? @unique

  accounts            Account[]
  sessions            Session[]
  subscriptions       Subscription[]
  vpnConfigs          VpnConfig[]
  auditLogs           AuditLog[]
  invoices            Invoice[]
  passwordResetTokens PasswordResetToken[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Plan {
  id                   String   @id @default(cuid())
  tier                 PlanTier @unique
  name                 String
  description          String
  priceMonthly         Int
  priceYearly          Int      @default(0)
  currency             String   @default("usd")
  stripePriceId        String?  @unique
  stripePriceIdYearly  String?  @unique
  trialDays            Int      @default(0)
  maxDevices           Int      @default(1)
  maxServers           Int      @default(1)
  bandwidthGB          Int      @default(50)
  features             String[]
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  planId               String
  status               SubscriptionStatus @default(INCOMPLETE)
  interval             BillingInterval    @default(MONTH)
  stripeSubscriptionId String?            @unique
  stripeCustomerId     String?
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  invoices Invoice[]

  @@index([userId])
  @@index([status])
}

model Invoice {
  id                String        @id @default(cuid())
  userId            String
  subscriptionId    String?
  stripeInvoiceId   String        @unique
  stripeCustomerId  String?
  number            String?
  status            InvoiceStatus
  amountDue         Int
  amountPaid        Int
  currency          String        @default("usd")
  hostedInvoiceUrl  String?
  invoicePdfUrl     String?
  periodStart       DateTime?
  periodEnd         DateTime?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([stripeCustomerId])
}

model ProcessedStripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@index([type])
}

model Server {
  id                 String       @id @default(cuid())
  name               String
  location           String
  country            String
  hostname           String       @unique
  endpoint           String
  publicKey          String
  listenPort         Int          @default(51820)
  dns                String       @default("1.1.1.1, 1.0.0.1")
  allowedIps         String       @default("0.0.0.0/0, ::/0")
  subnetCidr         String       @default("10.10.0.0/24")
  wgInterface        String       @default("wg0")
  status             ServerStatus @default(ONLINE)
  load               Int          @default(0)
  capacity           Int          @default(500)
  premiumOnly        Boolean      @default(false)
  // Remote management: encrypted SSH credentials. Null = unmanaged
  // (configs are still served to users but no remote sync is attempted).
  sshHost            String?
  sshPort            Int          @default(22)
  sshUser            String?
  sshPrivateKey      String?      @db.Text
  sshHostFingerprint String?
  serverPrivateKey   String?      @db.Text
  lastSyncedAt       DateTime?
  lastSyncError      String?      @db.Text
  lastHealthyAt      DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  vpnConfigs   VpnConfig[]
  healthChecks ServerHealthCheck[]
  syncJobs     PeerSyncJob[]

  @@index([status])
}

model VpnConfig {
  id            String          @id @default(cuid())
  userId        String
  serverId      String
  name          String
  publicKey     String
  privateKey    String          @db.Text  // AES-256-GCM encrypted
  presharedKey  String?         @db.Text  // AES-256-GCM encrypted
  address       String
  status        VpnConfigStatus @default(ACTIVE)
  expiresAt     DateTime?
  lastUsedAt    DateTime?
  lastSyncedAt  DateTime?
  bytesRxTotal  BigInt          @default(0)
  bytesTxTotal  BigInt          @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  server         Server           @relation(fields: [serverId], references: [id], onDelete: Cascade)
  trafficRecords TrafficRecord[]
  syncJobs       PeerSyncJob[]

  @@unique([serverId, address])
  @@index([userId])
  @@index([serverId])
  @@index([status, expiresAt])
}

model TrafficRecord {
  id              String   @id @default(cuid())
  vpnConfigId     String
  bytesRx         BigInt   @default(0)
  bytesTx         BigInt   @default(0)
  latestHandshake DateTime?
  recordedAt      DateTime @default(now())

  vpnConfig VpnConfig @relation(fields: [vpnConfigId], references: [id], onDelete: Cascade)

  @@index([vpnConfigId, recordedAt])
  @@index([recordedAt])
}

model ServerHealthCheck {
  id        String       @id @default(cuid())
  serverId  String
  status    ServerStatus
  latencyMs Int?
  peerCount Int?
  error     String?      @db.Text
  checkedAt DateTime     @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, checkedAt])
  @@index([checkedAt])
}

model PeerSyncJob {
  id          String         @id @default(cuid())
  serverId    String
  vpnConfigId String?
  publicKey   String
  action      PeerSyncAction
  status      PeerSyncStatus @default(PENDING)
  error       String?        @db.Text
  attempts    Int            @default(0)
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  server    Server     @relation(fields: [serverId], references: [id], onDelete: Cascade)
  vpnConfig VpnConfig? @relation(fields: [vpnConfigId], references: [id], onDelete: SetNull)

  @@index([serverId, status])
  @@index([status, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String?
  resourceId String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
